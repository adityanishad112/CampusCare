# ==========================================
# CampusCare Environment Configuration
# ==========================================

# Environment mode ('development' | 'production' | 'testing')
ENVIRONMENT=development

# Backend Secret Key (Change in production!)
JWT_SECRET_KEY=campuscare_super_secret_jwt_key_for_production_use_2025
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database URL
# For local SQLite development (zero-config, created automatically):
DATABASE_URL=sqlite:///./backend/campuscare.db

# For Docker or PostgreSQL production:
# DATABASE_URL=postgresql://campuscare_user:campuscare_password@localhost:5432/campuscare_db

# Allowed CORS Origins (comma separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:80,http://127.0.0.1:5173

# Frontend Vite API URL
VITE_API_BASE_URL=http://localhost:8000/api/v1
